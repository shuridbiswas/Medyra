# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code: version only the project engineering configuration. Everything else under .claude/
# (local settings, worktrees, transcripts, agent memory, third-party skill symlinks) stays local.
.claude/*
!.claude/settings.json
!.claude/agents/
!.claude/hooks/
!.claude/skills/
.claude/skills/*
!.claude/skills/medyra-*/
.claude/settings.local.json

# Autonomous engineering: runtime lock and temp files (state files are versioned)
engineering/.mutex
# Usage governor ledger and runtime files: personal subscription figures, never committed
engineering/.local/
engineering/*.tmp
engineering/runs/*.tmp
*.tsbuildinfo
supabase/.temp/
supabase/.branches/

# Netlify, Sentry
.netlify
.sentryclirc

# Dev seed output (contains generated passwords)
scripts/.seed-output/
scripts/.backup/
