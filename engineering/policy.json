{
  "version": 1,
  "ownerOnlyPaths": [
    "engineering/control.json",
    "engineering/approvals.json",
    "engineering/policy.json",
    ".claude/settings.json",
    ".claude/hooks/**",
    ".github/CODEOWNERS"
  ],
  "secretPaths": [
    ".env",
    ".env.local",
    ".env.*.local",
    ".env.production",
    ".env.development",
    "**/.env.local",
    "scripts/.seed-output/**",
    "scripts/.backup/**",
    "**/*.pem",
    "**/.credentials.json",
    "**/.git-credentials",
    "**/student-verification-evidence/**"
  ],
  "serializedPaths": [
    "supabase/migrations/**",
    "engineering/migrations.lock.json",
    "src/lib/supabase/database.types.ts",
    "supabase/tests/helpers.ts",
    "src/lib/rate-limit.ts",
    "src/proxy.ts",
    "src/features/notifications/format.ts",
    "src/features/safety/**",
    ".github/workflows/**",
    "netlify.toml",
    "next.config.ts",
    "package.json",
    "package-lock.json",
    "scripts/engineering/**"
  ],
  "securitySensitivePaths": [
    "src/lib/auth/**",
    "src/proxy.ts",
    "src/lib/supabase/**",
    "supabase/migrations/**",
    "src/features/student-verification/**",
    "src/features/verification/**",
    "src/features/forums/**",
    "src/features/safety/**",
    "src/features/admin/**",
    "src/features/privacy/**",
    "src/features/messaging/**",
    "src/features/security/**",
    "src/lib/rate-limit.ts",
    "src/lib/email/**",
    "src/lib/monitoring/**",
    "src/app/api/**",
    "src/app/admin/**",
    "src/app/privacy/**",
    "src/app/terms/**",
    "src/app/community-guidelines/**",
    "src/lib/legal.ts",
    "src/components/layout/draft-notice.tsx",
    "src/components/verification-chip.tsx",
    ".github/workflows/**",
    "netlify.toml",
    "next.config.ts",
    "package.json",
    "package-lock.json",
    ".claude/**",
    "scripts/engineering/**",
    "scripts/seed/**"
  ],
  "forbiddenCommands": [
    "db:reset:dev",
    "seed:wipe",
    "seed:clean",
    "seed:dev",
    "db:migrate",
    "seed:verification",
    "push --force",
    "push -f",
    "push --delete",
    "--delete",
    "push origin :",
    "--force-with-lease",
    "reset --hard origin",
    "branch -D main",
    "branch -D dev",
    "netlify deploy",
    "vercel deploy",
    "npx vercel",
    "supabase db push",
    "supabase db reset",
    "supabase link",
    ".env.local",
    ".credentials.json",
    ".seed-output",
    "npm install",
    "npm i ",
    "npm add",
    "npm uninstall",
    "npx supabase",
    "SUPABASE_ACCESS_TOKEN",
    "service_role"
  ],
  "mandatoryGates": ["lint", "typecheck", "unit", "pglite", "build", "secret-scan", "code-review"]
}
